# Copy to .env and fill in. Never commit .env.

# Password for the bundled PostgreSQL. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Admin token for the FIRST assembly, used once by scripts/seed_assembly.py.
# The app itself never reads this: tokens live (hashed) on each assembly
# record. After seeding you can delete this line. Leave it empty to have the
# seed script generate one. Generate with: openssl rand -base64 32
ADMIN_TOKEN=

# Public address of the site, no trailing slash. Check-in URLs and QR codes
# are built from it, so it must be what phones can reach.
BASE_URL=https://register.example.org

# Name of the first assembly, used by scripts/seed_assembly.py.
CHURCH_NAME=Your Assembly Name

# Attendance older than this is deleted by POST /admin/retention/run.
RETENTION_DAYS=730

# Optional: default check-in window for new services (local time).
# SERVICE_OPENS=08:30
# SERVICE_CLOSES=15:00
